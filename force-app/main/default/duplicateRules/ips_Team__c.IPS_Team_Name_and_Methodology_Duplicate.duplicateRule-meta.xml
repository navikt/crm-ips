<?xml version="1.0" encoding="UTF-8"?>
<DuplicateRule xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <actionOnInsert>Block</actionOnInsert>
    <actionOnUpdate>Block</actionOnUpdate>
    <alertText>An IPS Team with this name and methodology already exists.</alertText>
    <description>Blocks creation and editing of IPS Teams that duplicate the name and methodology of an existing team.</description>
    <duplicateRuleFilter>
        <booleanFilter xsi:nil="true"/>
    </duplicateRuleFilter>
    <duplicateRuleMatchRules>
        <matchRuleSObjectType>ips_Team__c</matchRuleSObjectType>
        <matchingRule>Team_Name_and_Methodology_Match</matchingRule>
    </duplicateRuleMatchRules>
    <isActive>true</isActive>
    <masterLabel>IPS Team Name and Methodology Duplicate</masterLabel>
    <securityOption>EnforceSharingRules</securityOption>
    <sortOrder>1</sortOrder>
</DuplicateRule>
