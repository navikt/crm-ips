<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Job_Meeting_Relationships</name>
        <label>Set Job Meeting Relationships</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.WhatId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Job.ips_Work_Trail__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.RelatedToAccount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Job.ips_Employer__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <customErrors>
        <name>Job_And_Opportunity_Selected</name>
        <label>Job And Opportunity Selected</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Velg enten mulighet eller jobb. Fjern verdien i ett av feltene.</errorMessage>
            <fieldSelection>CE_Job__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Job_Missing_Relationships</name>
        <label>Job Missing Relationships</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Jobben mangler arbeidsgiver eller jobbspor. Registrer begge på jobben før du oppretter møtet.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Job_Employer_Mismatch</name>
        <label>Job Employer Mismatch</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Arbeidsgiveren stemmer ikke med arbeidsgiveren på jobben. Velg «{!Get_Job.ips_Employer__r.Name}».</errorMessage>
            <fieldSelection>RelatedToAccount__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Meeting_Context</name>
        <label>Meeting Context</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Record_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Existing Discovery Meeting</defaultConnectorLabel>
        <rules>
            <name>Job_And_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CE_Job__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Discovery_Opportunity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Job_And_Opportunity_Selected</targetReference>
            </connector>
            <label>Job And Opportunity</label>
        </rules>
        <rules>
            <name>Job_Meeting</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CE_Job__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Job</targetReference>
            </connector>
            <label>Job Meeting</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Job_Relationships</name>
        <label>Check Job Relationships</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Job_Meeting_Relationships</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Use Job Work Trail And Employer</defaultConnectorLabel>
        <rules>
            <name>Missing_Job_Relationships</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Job.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Job.ips_Employer__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Job.ips_Work_Trail__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Job_Missing_Relationships</targetReference>
            </connector>
            <label>Missing Job Relationships</label>
        </rules>
        <rules>
            <name>Different_Employer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RelatedToAccount__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RelatedToAccount__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Job.ips_Employer__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Job_Employer_Mismatch</targetReference>
            </connector>
            <label>Different Employer</label>
        </rules>
    </decisions>
    <decisions>
        <name>Meeting_Type</name>
        <label>Meeting Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CE_Employer_Meeting</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Record_Type.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity</targetReference>
            </connector>
            <label>Employer Meeting Discovery Opportunity</label>
        </rules>
    </decisions>
    <description>Sets the work trail on Discovery opportunity employer meetings. For employer meetings linked to a job, derives the work trail and employer from CE_Job__c on every save and rejects a different employer. Rejects meetings linked to both a job and an opportunity without clearing either lookup. Both lookups remain optional on general CE employer meetings. The opportunity on the job is not used or changed.</description>
    <environments>Default</environments>
    <interviewLabel>CE - Update event with worktrail id {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CE - Update event with worktrail id</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
