        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_event_with_worktrail_id</name>
        <label>Update event with worktrail id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
