<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Capture_Save_Error</name>
        <label>Hent lagringsfeil</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>saveError</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>job.Id</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Roll_Back_Job</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Start_Date</name>
        <label>Sett startdato</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>job.ips_Start_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Start_Date</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Job</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Prefill_Job</name>
        <label>Fyll ut forslag til jobb</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>job.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Opportunity.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>job.ips_Work_Trail__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Opportunity.Work_Trail__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>job.Discovery_Opportunity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Opportunity.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>job.Opportunity_Conversion_Key__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Opportunity.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>job.ips_Employer__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Opportunity.CE_RelatedToAccount__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>job.ips_Start_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Opportunity.Agreement_Planned_Start_Date__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>job.ips_Number_of_hours__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Opportunity.Agreement_Hours__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>job.IPS_UO_Stillingsbeskrivelse__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Opportunity.Agreement_Main_Tasks__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Edit_Job</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Opportunity</name>
        <label>Kontroller muligheten</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Opportunity_Unavailable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Muligheten er utilgjengelig</defaultConnectorLabel>
        <rules>
            <name>Job_Already_Created</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.Created_Job__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Navigate_To_Job</targetReference>
            </connector>
            <label>Jobben er allerede opprettet</label>
        </rules>
        <rules>
            <name>Ready_To_Create</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity.Work_Trail__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Prefill_Job</targetReference>
            </connector>
            <label>Klar til å opprette jobb</label>
        </rules>
    </decisions>
    <description>Oppretter en jobb fra en mulighet med brukerens tilganger. Forslag fra arbeidsavtalen kan redigeres før lagring. Begge handlingene åpner den eksisterende jobben hvis muligheten allerede har en jobb. Opprettelse og kobling til muligheten lagres i én transaksjon. Tekstene i flyten er på norsk; objektfeltene bruker Salesforce sine feltetiketter.</description>
    <environments>Default</environments>
    <formulas>
        <name>targetJobId</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!job.Id}, {!Get_Opportunity.Created_Job__c})</expression>
    </formulas>
    <interviewLabel>CE - Opprett jobb fra mulighet {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CE - Opprett jobb fra mulighet</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Job</name>
        <label>Opprett jobb</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Link_Opportunity_To_Job</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Save_Error</targetReference>
        </faultConnector>
        <inputReference>job</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Opportunity</name>
        <label>Hent mulighet</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Opportunity</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Opportunity_Unavailable</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CE_Discovery_Opportunity__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordRollbacks>
        <name>Roll_Back_Job</name>
        <label>Tilbakestill lagringen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Save_Failed</targetReference>
        </connector>
    </recordRollbacks>
    <recordUpdates>
        <name>Link_Opportunity_To_Job</name>
        <label>Koble muligheten til jobben</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Navigate_To_Job</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Save_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Opportunity.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Created_Job__c</field>
            <value>
                <elementReference>job.Id</elementReference>
            </value>
        </inputAssignments>
        <object>CE_Discovery_Opportunity__c</object>
    </recordUpdates>
    <screens>
        <name>Edit_Job</name>
        <label>Rediger jobb</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Set_Start_Date</targetReference>
        </connector>
        <fields>
            <fieldType>ObjectProvided</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <objectFieldReference>job.Name</objectFieldReference>
        </fields>
        <fields>
            <fieldType>ObjectProvided</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <objectFieldReference>job.ips_Employer__c</objectFieldReference>
        </fields>
        <fields>
            <name>Contact_Source</name>
            <fieldText>&lt;p&gt;Velg en arbeidsgiverkontakt hvis det er aktuelt. Kontaktpersoner registrert i arbeidsavtalen:&lt;/p&gt;&lt;p&gt;{!Get_Opportunity.Agreement_Workplace_Contacts__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <fieldType>ObjectProvided</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <objectFieldReference>job.ips_Employer_contact__c</objectFieldReference>
        </fields>
        <fields>
            <name>Start_Date</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>job.ips_Start_Date__c</elementReference>
            </defaultValue>
            <fieldText>Startdato</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <fieldType>ObjectProvided</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <objectFieldReference>job.ips_End_Date__c</objectFieldReference>
        </fields>
        <fields>
            <fieldType>ObjectProvided</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <objectFieldReference>job.ips_Number_of_hours__c</objectFieldReference>
        </fields>
        <fields>
            <fieldType>ObjectProvided</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <objectFieldReference>job.IPS_UO_Stillingsbeskrivelse__c</objectFieldReference>
        </fields>
        <nextOrFinishButtonLabel>Opprett jobb</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Navigate_To_Job</name>
        <label>Åpne jobb</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>navigateToJob</name>
            <extensionName>c:fcFlowRecordNavigator</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>objectApiName</name>
                <value>
                    <stringValue>ips_Job__c</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>recordId</name>
                <value>
                    <elementReference>targetJobId</elementReference>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Opportunity_Unavailable</name>
        <label>Muligheten er utilgjengelig</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Opportunity_Error</name>
            <fieldText>&lt;p&gt;Vi kunne ikke hente muligheten og jobbsporet. Lukk vinduet og kontroller at muligheten er koblet til et jobbspor, og at du har tilgang. Kontakt brukerstøtte hvis problemet fortsetter.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Lukk</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Save_Failed</name>
        <label>Jobben ble ikke lagret</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <backButtonLabel>Tilbake</backButtonLabel>
        <fields>
            <name>Save_Error</name>
            <fieldText>&lt;p&gt;Ingen ny jobb ble lagret. Gå tilbake og kontroller opplysningene, eller lukk og åpne muligheten på nytt hvis noen andre allerede har opprettet jobben. Kontakt brukerstøtte hvis problemet fortsetter.&lt;/p&gt;&lt;p&gt;{!saveError}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Lukk</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>job</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ips_Job__c</objectType>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>saveError</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
