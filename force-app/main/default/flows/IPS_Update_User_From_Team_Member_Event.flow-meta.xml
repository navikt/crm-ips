    <description>Checks the event creator&apos;s Give Access to Jobbsporet custom permission and updates User.ManagerId and User.UserRoleId according to issue 3074. Preserves the profile scope from IPS_Admin_GiveUserAccess. No team records are read or changed. Unchanged values cause no User DML.</description>
    <environments>Default</environments>
    <formulas>
        <name>areReferencesValid</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISBLANK({!Get_Target_User.Id})),
    OR(
        {!Get_Target_User.Profile.Name} = &quot;NAV Kontor&quot;,
        {!Get_Target_User.Profile.Name} = &quot;NAV UO Jobbspesialist&quot;,
        {!Get_Target_User.Profile.Name} = &quot;NAV UO Metodeveileder&quot;,
        {!Get_Target_User.Profile.Name} = &quot;NAV IPS Jobbspesialist&quot;,
        {!Get_Target_User.Profile.Name} = &quot;NAV IPS Metodeveileder&quot;
    ),
    OR(
        ISBLANK({!requestedManagerId}),
        AND(
            NOT(ISBLANK({!Get_Manager.Id})),
            {!Get_Manager.Id} &lt;&gt; {!Get_Target_User.Id},
            OR(
                {!Get_Manager.Profile.Name} = &quot;NAV Kontor&quot;,
                {!Get_Manager.Profile.Name} = &quot;NAV UO Jobbspesialist&quot;,
                {!Get_Manager.Profile.Name} = &quot;NAV UO Metodeveileder&quot;,
                {!Get_Manager.Profile.Name} = &quot;NAV IPS Jobbspesialist&quot;,
                {!Get_Manager.Profile.Name} = &quot;NAV IPS Metodeveileder&quot;
            )
        )
    ),
    OR(
        ISBLANK({!requestedRoleId}),
        NOT(ISBLANK({!Get_Requested_Role.Id}))
    )
)</expression>
    </formulas>
    <formulas>
        <name>isManagerChanged</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISBLANK({!requestedManagerId})),
    {!Get_Manager.Id} &lt;&gt; {!Get_Target_User.ManagerId}
)</expression>
    </formulas>
    <formulas>
        <name>isPublisherAuthorized</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    {!$User.Id} = {!$Record.CreatedById},
    {!$User.IsActive},
    {!$Permission.IPS_Admin_GiveAccessToJobbsporetUsers}
)</expression>
    </formulas>
    <formulas>
        <name>isRoleChanged</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISBLANK({!requestedRoleId})),
    {!isRoleTransitionAllowed},
    {!Get_Requested_Role.Id} &lt;&gt; {!Get_Target_User.UserRoleId}
)</expression>
    </formulas>
    <formulas>
        <name>isRoleRejected</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISBLANK({!requestedRoleId})),
    NOT({!isRoleTransitionAllowed})
)</expression>
    </formulas>
    <formulas>
        <name>isRoleTransitionAllowed</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISBLANK({!Get_Target_User.UserRoleId})),
    OR(
        {!Get_Target_User.UserRole.Name} = &quot;NAV Kontor&quot;,
        CONTAINS({!Get_Target_User.UserRole.Name}, &quot;Jobbspesialist&quot;),
        CONTAINS({!Get_Target_User.UserRole.Name}, &quot;Metodeveileder&quot;)
    ),
    OR(
        CONTAINS({!Get_Requested_Role.Name}, &quot;Jobbspesialist&quot;),
        CONTAINS({!Get_Requested_Role.Name}, &quot;Metodeveileder&quot;)
    )
)</expression>
    </formulas>
    <formulas>
        <name>requestedManagerId</name>
        <dataType>String</dataType>
        <expression>TRIM({!$Record.ips_Manager__c})</expression>
    </formulas>
    <formulas>
        <name>requestedRoleId</name>
        <dataType>String</dataType>
        <expression>TRIM({!$Record.ips_Role__c})</expression>
    </formulas>
    <formulas>
        <name>requestedUserId</name>
        <dataType>String</dataType>
        <expression>TRIM({!$Record.ips_User__c})</expression>
    </formulas>
    <formulas>
        <name>requestFailureMessage</name>
        <dataType>String</dataType>
        <expression>IF(
    {!isPublisherAuthorized},
    &quot;Forespørselen kunne ikke behandles. Brukeren ble ikke oppdatert. Kontroller bruker, leder og rolle før ny innsending.&quot;,
    &quot;Avsenderen av hendelsen mangler gyldig tilgang. Brukeren ble ikke oppdatert. Be administratoren kontrollere tilgangen før ny innsending.&quot;
) &amp; &quot; Referanse: &quot; &amp; {!$Flow.InterviewGuid}</expression>
    </formulas>
    <formulas>
        <name>roleRejectionMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Rolleovergangen er ikke tillatt. Gjeldende rolle er beholdt. Kontroller gjeldende og ønsket rolle. Referanse: &quot; &amp; {!$Flow.InterviewGuid}</expression>
    </formulas>
    <formulas>
        <name>updateFailureMessage</name>
        <dataType>String</dataType>
        <expression>IF(
    {!isRoleRejected},
    &quot;Rolleovergangen er ikke tillatt. Gjeldende rolle er beholdt. &quot;,
    &quot;&quot;
) &amp; &quot;Oppdateringen av brukeren feilet. Be administratoren undersøke feilen i Flowen før ny innsending. Referanse: &quot; &amp; {!$Flow.InterviewGuid}</expression>
    </formulas>
