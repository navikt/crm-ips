<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Copy_Selected_Task</name>
        <label>Kopier valgt oppgave</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>supportTask.Name</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Selected_Tasks.Name</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>supportTask.Job__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Refresh_Job.Id</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>supportTask.Source_Analysis_Task_Id__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Selected_Tasks.Id</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>supportTask.Task_Type__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Selected_Tasks.Task_Type__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>supportTask.Frequency__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Selected_Tasks.Frequency__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>supportTask.Task_Steps__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Selected_Tasks.Task_Steps__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>supportTask.Quality_Criteria__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Selected_Tasks.Quality_Criteria__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>supportTask.Tools_and_Equipment__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Selected_Tasks.Tools_and_Equipment__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>supportTask.Pace_and_Accuracy__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Selected_Tasks.Pace_and_Accuracy__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>supportTask.Training_Provider__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Refresh_Job.Analysis_Supporters__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>supportTask.Specialist_Training_Support__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Refresh_Job.Analysis_Specialist_Support__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>supportTasks</assignToReference>
            <operator>Add</operator>
            <value><elementReference>supportTask</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Loop_Selected_Tasks</targetReference></connector>
    </assignments>
    <decisions>
        <name>Check_Job</name>
        <label>Kontroller jobben</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector><targetReference>Job_Unavailable</targetReference></defaultConnector>
        <defaultConnectorLabel>Jobben er utilgjengelig</defaultConnectorLabel>
        <rules>
            <name>Plan_Already_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Job.Has_Job_Support_Plan__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Plan_Already_Created</targetReference></connector>
            <label>Planen er allerede opprettet</label>
        </rules>
        <rules>
            <name>Job_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Job.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Get_Analysis_Tasks</targetReference></connector>
            <label>Jobben er tilgjengelig</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Analysis_Tasks</name>
        <label>Kontroller analyseoppgavene</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector><targetReference>No_Analysis_Tasks</targetReference></defaultConnector>
        <defaultConnectorLabel>Ingen oppgaver</defaultConnectorLabel>
        <rules>
            <name>Tasks_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Analysis_Tasks</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Select_Tasks</targetReference></connector>
            <label>Oppgaver finnes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Current_Job</name>
        <label>Kontroller jobben før lagring</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector><targetReference>Job_Unavailable</targetReference></defaultConnector>
        <defaultConnectorLabel>Jobben er utilgjengelig</defaultConnectorLabel>
        <rules>
            <name>Plan_Created_While_Selecting</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Refresh_Job.Has_Job_Support_Plan__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Plan_Already_Created</targetReference></connector>
            <label>Planen er allerede opprettet</label>
        </rules>
        <rules>
            <name>Ready_To_Copy</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Refresh_Job.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Selected_Tasks.selectedRows</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Loop_Selected_Tasks</targetReference></connector>
            <label>Klar til å kopiere</label>
        </rules>
    </decisions>
    <description
    >Oppretter én jobbstøtteplan per jobb uten et eget planobjekt. Brukeren velger blant jobbens analyseoppgaver på CE_Task__c. Valgte oppgaver kopieres til CE_Job_Support_Task__c. Oppgavefeltene og jobbens opplæringsfelt kopieres én gang, uten synkronisering. Oppgavene og jobbens opprettelsesmarkering lagres i samme transaksjon. Flyten bruker brukerens tilganger og viser feil uten å logge oppgaveinnhold.</description>
    <environments>Default</environments>
    <interviewLabel>CE - Opprett jobbstøtteplan {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CE - Opprett jobbstøtteplan</label>
    <loops>
        <name>Loop_Selected_Tasks</name>
        <label>Gå gjennom valgte oppgaver</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Selected_Tasks.selectedRows</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector><targetReference>Copy_Selected_Task</targetReference></nextValueConnector>
        <noMoreValuesConnector><targetReference>Create_Support_Tasks</targetReference></noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Support_Tasks</name>
        <label>Opprett jobbstøtteoppgaver</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Mark_Plan_Created</targetReference></connector>
        <faultConnector><targetReference>Roll_Back_Plan</targetReference></faultConnector>
        <inputReference>supportTasks</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Job</name>
        <label>Hent jobben</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Check_Job</targetReference></connector>
        <faultConnector><targetReference>Job_Unavailable</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ips_Job__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Analysis_Tasks</name>
        <label>Hent jobbens analyseoppgaver</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Check_Analysis_Tasks</targetReference></connector>
        <faultConnector><targetReference>Job_Unavailable</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Job__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>Get_Job.Id</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>CE_Task__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Refresh_Job</name>
        <label>Hent jobben på nytt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Check_Current_Job</targetReference></connector>
        <faultConnector><targetReference>Job_Unavailable</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ips_Job__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordRollbacks>
        <name>Roll_Back_Plan</name>
        <label>Tilbakestill lagringen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Save_Failed</targetReference></connector>
    </recordRollbacks>
    <recordUpdates>
        <name>Mark_Plan_Created</name>
        <label>Marker jobbstøtteplanen som opprettet</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Plan_Created</targetReference></connector>
        <faultConnector><targetReference>Roll_Back_Plan</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>Refresh_Job.Id</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Has_Job_Support_Plan__c</field>
            <value><booleanValue>true</booleanValue></value>
        </inputAssignments>
        <object>ips_Job__c</object>
    </recordUpdates>
    <screens>
        <name>Select_Tasks</name>
        <label>Velg oppgaver til jobbstøtteplanen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>Refresh_Job</targetReference></connector>
        <fields>
            <name>Selection_Information</name>
            <fieldText
            >&lt;p&gt;Velg oppgavene fra utvidet jobbanalyse som skal inngå i jobbstøtteplanen for &lt;strong&gt;{!Get_Job.Name}&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;Oppgavene kopieres når du trykker på «Opprett jobbstøtteplan». Deretter kan du redigere oppsummeringene uten å endre analysen. Du kan også opprette nye arbeidsoppgaver fra tidslinjene. Oppgaver i planen kan ikke slettes.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Selected_Tasks</name>
            <dataTypeMappings>
                <typeName>T</typeName>
                <typeValue>CE_Task__c</typeValue>
            </dataTypeMappings>
            <extensionName>flowruntime:datatable</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>label</name>
                <value><stringValue>Arbeidsoppgaver</stringValue></value>
            </inputParameters>
            <inputParameters>
                <name>selectionMode</name>
                <value><stringValue>MULTI_SELECT</stringValue></value>
            </inputParameters>
            <inputParameters>
                <name>minRowSelection</name>
                <value><numberValue>1.0</numberValue></value>
            </inputParameters>
            <inputParameters>
                <name>tableData</name>
                <value><elementReference>Get_Analysis_Tasks</elementReference></value>
            </inputParameters>
            <inputParameters>
                <name>columns</name>
                <value><stringValue
                    >[{&quot;apiName&quot;:&quot;Name&quot;,&quot;guid&quot;:&quot;column-name&quot;,&quot;editable&quot;:false,&quot;hasCustomHeaderLabel&quot;:true,&quot;customHeaderLabel&quot;:&quot;Arbeidsoppgave&quot;,&quot;wrapText&quot;:true,&quot;order&quot;:0,&quot;label&quot;:&quot;Arbeidsoppgave&quot;,&quot;type&quot;:&quot;text&quot;},{&quot;apiName&quot;:&quot;Task_Type__c&quot;,&quot;guid&quot;:&quot;column-type&quot;,&quot;editable&quot;:false,&quot;hasCustomHeaderLabel&quot;:true,&quot;customHeaderLabel&quot;:&quot;Oppgavetype&quot;,&quot;wrapText&quot;:true,&quot;order&quot;:1,&quot;label&quot;:&quot;Oppgavetype&quot;,&quot;type&quot;:&quot;text&quot;},{&quot;apiName&quot;:&quot;Frequency__c&quot;,&quot;guid&quot;:&quot;column-frequency&quot;,&quot;editable&quot;:false,&quot;hasCustomHeaderLabel&quot;:true,&quot;customHeaderLabel&quot;:&quot;Når og hvor ofte&quot;,&quot;wrapText&quot;:true,&quot;order&quot;:2,&quot;label&quot;:&quot;Når og hvor ofte&quot;,&quot;type&quot;:&quot;text&quot;}]</stringValue></value>
            </inputParameters>
            <inputParameters>
                <name>shouldDisplayLabel</name>
                <value><booleanValue>true</booleanValue></value>
            </inputParameters>
            <inputParameters>
                <name>keyField</name>
                <value>
                    <complexValue
                    >{&quot;dataType&quot;:&quot;SObject&quot;,&quot;objectType&quot;:&quot;CE_Task__c&quot;,&quot;fieldReferences&quot;:[&quot;Id&quot;],&quot;elementReference&quot;:&quot;Get_Analysis_Tasks&quot;}</complexValue>
                    <complexValueType>ComplexObjectFieldDetails</complexValueType>
                </value>
            </inputParameters>
            <inputParameters>
                <name>columnReferences</name>
                <value>
                    <complexValue
                    >{&quot;dataType&quot;:&quot;SObject&quot;,&quot;objectType&quot;:&quot;CE_Task__c&quot;,&quot;fieldReferences&quot;:[&quot;Name&quot;,&quot;Task_Type__c&quot;,&quot;Frequency__c&quot;],&quot;elementReference&quot;:&quot;Get_Analysis_Tasks&quot;}</complexValue>
                    <complexValueType>ComplexObjectFieldDetails</complexValueType>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
        </fields>
        <nextOrFinishButtonLabel>Opprett jobbstøtteplan</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Plan_Created</name>
        <label>Jobbstøtteplanen er opprettet</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Plan_Created_Message</name>
            <fieldText
            >&lt;p&gt;&lt;strong style=&quot;font-size: 18px;&quot;&gt;Jobbstøtteplanen er opprettet.&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Lukk</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Plan_Already_Created</name>
        <label>Jobbstøtteplanen finnes allerede</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Existing_Plan_Message</name>
            <fieldText
            >&lt;p&gt;Jobbstøtteplanen for denne jobben er allerede opprettet. Ingen nye oppgaver er lagt til. Lukk vinduet og åpne fanen «Jobbstøtteplan».&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Lukk</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>No_Analysis_Tasks</name>
        <label>Jobben mangler analyseoppgaver</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>No_Tasks_Message</name>
            <fieldText
            >&lt;p&gt;Det finnes ingen tilgjengelige analyseoppgaver for denne jobben. Opprett arbeidsoppgaver under «Utvidet jobbanalyse» før du oppretter jobbstøtteplanen.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Lukk</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Job_Unavailable</name>
        <label>Jobben eller oppgavene er utilgjengelige</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Unavailable_Message</name>
            <fieldText
            >&lt;p&gt;Vi kunne ikke hente jobben eller oppgavene. Ingen endringer er lagret. Lukk vinduet og prøv igjen fra jobben. Kontakt brukerstøtte hvis problemet fortsetter.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Lukk</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Save_Failed</name>
        <label>Jobbstøtteplanen kunne ikke lagres</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Save_Error_Message</name>
            <fieldText
            >&lt;p&gt;Vi kunne ikke opprette jobbstøtteplanen. Ingen endringer fra dette forsøket er lagret.&lt;/p&gt;&lt;p&gt;Lukk vinduet og oppdater jobbsiden. Kontroller om planen allerede er opprettet, og at analyseoppgavene har oppgavetype. Prøv igjen hvis planen ikke finnes. Kontakt brukerstøtte hvis problemet fortsetter.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Lukk</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Get_Job</targetReference></connector>
    </start>
