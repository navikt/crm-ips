    <decisions>
        <name>Role_Changed</name>
        <label>Role Changed ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Profile_Changed_To_Nav_Kontor</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CRM_UserProfileName__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NAV Kontor</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.CRM_UserProfileName__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NAV IPS Jobbspesialist</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.CRM_UserProfileName__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NAV UO Jobbspesialist</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Transfer_All_Worktrails_True</targetReference>
            </connector>
            <label>Profile Changed To NAV Kontor</label>
        </rules>
        <rules>
            <name>Role_Changed_Outcome</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.UserRoleId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.UserRoleId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_UserProfileName__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NAV IPS Jobbspesialist</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CRM_UserProfileName__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NAV UO Jobbspesialist</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Transfer_All_Worktrails_False</targetReference>
            </connector>
            <label>Role Changed</label>
        </rules>
    </decisions>
