<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Episodic_Support_Job_Id__c</fullName>
    <description
    >Filters the shared timeline query before pagination so episodic tasks are loaded independently of core tasks.</description>
    <formula>IF(ISPICKVAL(Task_Type__c, "Episodic task"), CASESAFEID(Job__c), "")</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Episodic support job ID</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
</CustomField>
